      "items": [
        {
          "id": "item-1",
          "text": "季度复盘",
          "style": { "fontSize": 14, "fontWeight": "600" }
        }
      ]
    },
    {
      "position": "q2",
      "title": "顺手优化",
      "tone": "green",
      "hints": [],
      "items": [{ "id": "item-2", "text": "文档模板", "style": {} }]
    }
  ],
  "markers": [],
  "toolbarGroupOrderByPanelId": {
    "panel-1": [
      "history",
      "text",
      "color",
      "paragraph",
      "insert",
      "table",
      "blocks",
      "notes",
      "review",
      "view",
      "other"
    ]
  },
  "toolbarGroupButtonsByPanelId": {
    "panel-1": {
      "text": {
        "order": [
          "heading",
          "bold",
          "italic",
          "underline",
          "strike",
          "subscript",
          "superscript",
