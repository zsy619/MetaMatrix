    {
      "id": "demand_qualitative",
      "title": "定性取舍",
      "items": [
        {
          "id": "fsd_dq_h1",
          "text": "<p><strong style=\"font-weight: 650\">画像:</strong></p>",
          "style": {
            "color": "#3c4043",
            "fontSize": 13,
            "fontWeight": "650"
          }
        },
        {
          "id": "fsd_dq_1",
          "text": "<p>1) 想做大的创业者</p>",
          "style": {
            "color": "#3c4043",
            "fontSize": 13,
            "fontWeight": "500"
          }
        },
        {
          "id": "fsd_dq_2",
          "text": "<p>2) 筹备到 B 轮（<5kw）</p>",
          "style": {
            "color": "#3c4043",
            "fontSize": 13,
            "fontWeight": "500"
          }
        },
        {
          "id": "fsd_dq_3",
          "text": "<p>3) 务实有学习陪伴潜力</p>",
          "style": {
            "color": "#3c4043",
            "fontSize": 13,
            "fontWeight": "500"
          }
        },
        {
          "id": "fsd_dq_h2",
          "text": "<p><strong style=\"font-weight: 650\">问题:</strong></p>",
          "style": {
            "color": "#3c4043",
            "fontSize": 13,
            "fontWeight": "650"
          }
        },
        {
          "id": "fsd_dq_4",
          "text": "<p>1) 缺少认知/执行框架</p>",
          "style": {
            "color": "#3c4043",
            "fontSize": 13,
            "fontWeight": "500"
          }
        },
        {
          "id": "fsd_dq_5",
          "text": "<p>2) 解决真实创业问题</p>",
          "style": {
            "color": "#3c4043",
            "fontSize": 13,
            "fontWeight": "500"
          }
        },
        {
          "id": "fsd_dq_6",
          "text": "<p>3) 希望融资 & 赛道领先</p>",
          "style": {
            "color": "#3c4043",
            "fontSize": 13,
            "fontWeight": "500"
          }
        },
        {
          "id": "fsd_dq_h3",
          "text": "<p><span style=\"color: #d93025\"><strong style=\"font-weight: 650\">非用户:</strong></span></p>",
          "style": {
            "color": "#d93025",
            "fontSize": 13,
            "fontWeight": "650"
          }
        },
        {
          "id": "fsd_dq_7",
          "text": "<p><span style=\"color: #d93025\">1) 没创业想法的大学生</span></p>",
          "style": {
            "color": "#d93025",
            "fontSize": 13,
            "fontWeight": "500"
          }
        },
        {
          "id": "fsd_dq_8",
          "text": "<p><span style=\"color: #d93025\">2) 只做单店的生意人</span></p>",
          "style": {
            "color": "#d93025",
            "fontSize": 13,
            "fontWeight": "500"
          }
        },
        {
          "id": "fsd_dq_9",
          "text": "<p><span style=\"color: #d93025\">3) 纯社交型创业者</span></p>",
          "style": {
            "color": "#d93025",
            "fontSize": 13,
            "fontWeight": "500"
          }
        }
      ]
    },
