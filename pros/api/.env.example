# Docker Compose Postgres (host port 5433) — recommended
DATABASE_URL=postgresql://metamatrix:metamatrix@localhost:5433/metamatrix

# Homebrew postgresql@16 (port 5432):
# DATABASE_URL=postgresql://metamatrix:metamatrix@localhost:5432/metamatrix

PORT=3000
JWT_SECRET=change-me-in-production-metamatrix-jwt-secret

# Comma-separated browser origins. A lone * is ignored.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login failure window. See docs/生产配置.md.
LOGIN_WINDOW=15m
LOGIN_PAIR_LIMIT=8
LOGIN_IP_LIMIT=30
