# Docker Compose Postgres (host port 5432) — recommended
DATABASE_URL=postgresql://metamatrix:metamatrix@localhost:5432/metamatrix

# Homebrew postgresql@16 (port 5432):
# DATABASE_URL=postgresql://metamatrix:metamatrix@localhost:5432/metamatrix

PORT=3000
JWT_SECRET=change-me-in-production-metamatrix-jwt-secret

# Comma-separated browser origins. A lone * is ignored.
CORS_ORIGINS=https://metamatrix.yy24365.com,https://localhost:5173

# Login failure window. See docs/生产配置.md.
LOGIN_WINDOW=15m
LOGIN_PAIR_LIMIT=8
LOGIN_IP_LIMIT=30

# Captcha. Never turn the debug switches on in production.
# CAPTCHA_TTL=5m
# CAPTCHA_DEBUG=true          # every caller gets the plain answer (local only)
# CAPTCHA_DEBUG_LOOPBACK=true # only 127.0.0.1 / ::1 gets the plain answer (CI)

# ===== 找回密码：邮件通道 =====
# MAIL_MODE:
#   smtp 强制走 SMTP（配置不全时启动直接失败）
#   log  只把邮件写进 API 日志（本地开发用，验证码可在日志/响应里看到）
#   auto 配置完整就走 SMTP；否则开发用日志、生产用禁用通道（接口回 503，不假装成功）
# MAIL_MODE=auto
#
# 465 端口走隐式 TLS，587 走 STARTTLS，填端口即可切换。
# 下面四组任选其一，取消注释后填入自己的账号即可。
#
# --- Brevo（免费 300 封/天）---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your-account@example.com
# SMTP_PASSWORD=your-brevo-smtp-key
# SMTP_FROM=no-reply@yourdomain.com
#
# --- 阿里云邮件推送（免费 2000 封/天，日发 200）---
# SMTP_HOST=smtpdm.aliyun.com
# SMTP_PORT=465
# SMTP_USERNAME=no-reply@yourdomain.com
# SMTP_PASSWORD=your-alicloud-smtp-password
# SMTP_FROM=no-reply@yourdomain.com
#
# --- 腾讯云 SES ---
# SMTP_HOST=smtp.qcloudmail.com
# SMTP_PORT=465
# SMTP_USERNAME=your-ses-account
# SMTP_PASSWORD=your-ses-smtp-password
# SMTP_FROM=no-reply@yourdomain.com
#
# --- QQ 邮箱（个人邮箱，日限约 50 封，密码填授权码）---
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=2339698190@qq.com
SMTP_PASSWORD=xxxx
SMTP_FROM=2339698190@qq.com
SMTP_FROM_NAME=元矩阵 MetaMatrix

# 发件人显示名。含中文时会自动做 RFC 2047 编码。
# SMTP_FROM_NAME=元矩阵 MetaMatrix
# 跳过证书校验，只能用于自签证书的内网中继。
# SMTP_INSECURE=false
# SMTP_TIMEOUT=15s

# ===== 找回密码：验证码与频率限制 =====
# RESET_CODE_TTL=10m
# RESET_CODE_MAX_ATTEMPTS=5
# RESET_COOLDOWN=60s
# RESET_HOURLY_PER_ADDRESS=5
# RESET_DAILY_PER_ADDRESS=10
# RESET_HOURLY_PER_IP=20
# 日志通道下把验证码回显到接口响应，仅限本地开发。
# RESET_REVEAL_CODE=false
# explicit（默认）：未知邮箱返回 404 email_not_registered，页面直接提示"这个邮箱还没注册"
# uniform：未知邮箱返回与已注册完全一致的响应，防账号枚举，但用户不知道是自己写错了邮箱
# RESET_UNKNOWN_EMAIL_MODE=explicit

