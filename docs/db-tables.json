{
  "domains": [
    "core",
    "kb",
    "base",
    "media"
  ],
  "tables": [
    {
      "name": "core_activity_logs",
      "domain": "core",
      "purpose": "操作审计留痕（登录、退出、写操作）",
      "model": "ActivityLog"
    },
    {
      "name": "core_backup_imports",
      "domain": "core",
      "purpose": "备份导入批次记录",
      "model": "BackupImport"
    },
    {
      "name": "core_page_references",
      "domain": "core",
      "purpose": "文档反向引用索引（@提及 / 内嵌块）",
      "model": "PageReference"
    },
    {
      "name": "core_password_reset_tokens",
      "domain": "core",
      "purpose": "密码重置令牌与会话",
      "model": "PasswordResetToken"
    },
    {
      "name": "core_projects",
      "domain": "core",
      "purpose": "项目：画布/文档的归属分组",
      "model": "Project"
    },
    {
      "name": "core_user_notifications",
      "domain": "core",
      "purpose": "站内通知（评论/回复/@）",
      "model": "UserNotification"
    },
    {
      "name": "core_users",
      "domain": "core",
      "purpose": "账号（登录、密码重置、目录通讯录）",
      "model": "User"
    },
    {
      "name": "kb_chunks",
      "domain": "kb",
      "purpose": "向量检索切片",
      "model": "KnowledgeChunk"
    },
    {
      "name": "kb_comment_reads",
      "domain": "kb",
      "purpose": "评论已读位",
      "model": "DocCommentRead"
    },
    {
      "name": "kb_comments",
      "domain": "kb",
      "purpose": "文档评论与回复",
      "model": "DocComment"
    },
    {
      "name": "kb_content_blocks",
      "domain": "kb",
      "purpose": "正文结构块索引（检索与 AI 上下文）",
      "model": "CanvasContentBlock"
    },
    {
      "name": "kb_crdt_updates",
      "domain": "kb",
      "purpose": "协同编辑增量（Yjs / CRDT）",
      "model": "DocCRDTUpdate"
    },
    {
      "name": "kb_doc_audit_events",
      "domain": "kb",
      "purpose": "用户+文档级审计（谁在何时改了哪个块）",
      "model": "DocAuditEvent"
    },
    {
      "name": "kb_doc_block_refs",
      "domain": "kb",
      "purpose": "块级引用反查",
      "model": "DocBlockRef"
    },
    {
      "name": "kb_doc_block_revisions",
      "domain": "kb",
      "purpose": "块修订历史",
      "model": "DocBlockRevision"
    },
    {
      "name": "kb_doc_blocks",
      "domain": "kb",
      "purpose": "正文派生块表（稳定 data-block-id，含块级权限）",
      "model": "DocBlock"
    },
    {
      "name": "kb_doc_operations",
      "domain": "kb",
      "purpose": "正文 Yjs 协同操作日志（不是保存幂等的 kb_save_operations）",
      "model": "DocOperation"
    },
    {
      "name": "kb_doc_properties",
      "domain": "kb",
      "purpose": "文档页面属性（状态、负责人、标签、封面）",
      "model": "DocProperty"
    },
    {
      "name": "kb_doc_versions",
      "domain": "kb",
      "purpose": "文档历史版本快照（可读可对比）",
      "model": "KnowledgeDocVersion"
    },
    {
      "name": "kb_documents",
      "domain": "kb",
      "purpose": "文档正文真源（doc / canvas / mindmap / sheet）",
      "model": "CanvasDocument"
    },
    {
      "name": "kb_events",
      "domain": "kb",
      "purpose": "知识库变更事件流",
      "model": "KnowledgeEvent"
    },
    {
      "name": "kb_members",
      "domain": "kb",
      "purpose": "空间成员与角色",
      "model": "KnowledgeMember"
    },
    {
      "name": "kb_node_data",
      "domain": "kb",
      "purpose": "节点结构化数据（思维导图、表格等）",
      "model": "KnowledgeNodeData",
      "massNoun": true
    },
    {
      "name": "kb_nodes",
      "domain": "kb",
      "purpose": "知识库目录树节点（folder / doc）",
      "model": "KnowledgeNode"
    },
    {
      "name": "kb_presence",
      "domain": "kb",
      "purpose": "在线状态与协同 presence",
      "model": "KnowledgePresence",
      "massNoun": true
    },
    {
      "name": "kb_revisions",
      "domain": "kb",
      "purpose": "文档修订历史快照",
      "model": "CanvasRevision"
    },
    {
      "name": "kb_save_operations",
      "domain": "kb",
      "purpose": "保存幂等记录（operationId 去重）",
      "model": "DocumentSaveOperation"
    },
    {
      "name": "kb_shares",
      "domain": "kb",
      "purpose": "文档与节点分享链接",
      "model": "KnowledgeShare"
    },
    {
      "name": "kb_tags",
      "domain": "kb",
      "purpose": "业务标签词库",
      "model": "KnowledgeTagDict"
    },
    {
      "name": "kb_templates",
      "domain": "kb",
      "purpose": "文档模板（内置 / 团队 / 个人）",
      "model": "KnowledgeTemplate"
    },
    {
      "name": "kb_views",
      "domain": "kb",
      "purpose": "最近浏览记录",
      "model": "KnowledgeView"
    },
    {
      "name": "base_apps",
      "domain": "base",
      "purpose": "多维表格应用（Base）",
      "model": "BaseApp"
    },
    {
      "name": "base_event_outboxes",
      "domain": "base",
      "purpose": "多维表格事件发件箱",
      "model": "BaseEventOutbox"
    },
    {
      "name": "base_field_formulas",
      "domain": "base",
      "purpose": "字段公式定义",
      "model": "BaseFieldFormula"
    },
    {
      "name": "base_fields",
      "domain": "base",
      "purpose": "多维表格字段",
      "model": "BaseField"
    },
    {
      "name": "base_formula_dependencies",
      "domain": "base",
      "purpose": "公式依赖图",
      "model": "BaseFormulaDependency"
    },
    {
      "name": "base_operation_logs",
      "domain": "base",
      "purpose": "多维表格操作审计",
      "model": "BaseOperationLog"
    },
    {
      "name": "base_record_links",
      "domain": "base",
      "purpose": "记录关联关系",
      "model": "BaseRecordLink"
    },
    {
      "name": "base_record_values",
      "domain": "base",
      "purpose": "记录的类型化投影值",
      "model": "BaseRecordValue"
    },
    {
      "name": "base_records",
      "domain": "base",
      "purpose": "多维表格记录",
      "model": "BaseRecord"
    },
    {
      "name": "base_tables",
      "domain": "base",
      "purpose": "多维表格数据表",
      "model": "BaseTable"
    },
    {
      "name": "base_views",
      "domain": "base",
      "purpose": "多维表格视图（网格 / 看板 / 画廊）",
      "model": "BaseView"
    },
    {
      "name": "media_assets",
      "domain": "media",
      "purpose": "素材文件（图片、音视频等）",
      "model": "MediaAsset"
    },
    {
      "name": "media_categories",
      "domain": "media",
      "purpose": "素材分类",
      "model": "MediaCategory"
    },
    {
      "name": "media_references",
      "domain": "media",
      "purpose": "素材被引用关系",
      "model": "MediaReference"
    }
  ]
}
